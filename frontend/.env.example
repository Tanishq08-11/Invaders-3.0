# Backend base URL, no trailing slash.
#   "/"                      same origin (default: Flask serves the build; `npm run dev` proxies /api to :5000)
#   http://host:5000         a separately hosted backend (needs CORS_ORIGINS + SESSION_COOKIE_SECURE on the backend)
#   (empty)                  disconnected "awaiting backend connection" states
VITE_API_BASE_URL=/
# Dev builds only: render the layouts without a session (no data, no auth bypass in production).
VITE_UI_PREVIEW=false
