# Copy to .env.local (gitignored) to override. No secrets belong in any VITE_* variable:
# everything here is compiled into the public JavaScript bundle.

# Backend base URL, no trailing slash.
#   "/" or empty      same origin (recommended): Flask serves frontend/dist, and `npm run dev`
#                     proxies /api to VITE_BACKEND_URL below. Cookies and SSE work unchanged.
#   http://host:5000  a separately hosted backend. The backend then needs
#                     CORS_ORIGINS=<this frontend's origin> (credentials are only allowed for an
#                     explicit origin list) and SESSION_COOKIE_SECURE=true when served over HTTPS.
# A malformed value is reported in the UI ("Backend URL misconfigured") instead of silently
# disabling requests.
VITE_API_BASE_URL=/

# `npm run dev` only: where the dev-server proxy forwards /api (default http://127.0.0.1:5000).
# VITE_BACKEND_URL=http://127.0.0.1:5000

# Dev builds only: render the layouts without a session (no data, no auth bypass).
# Compiled out of production builds. Keep false for normal work.
VITE_UI_PREVIEW=false
